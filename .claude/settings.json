{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": ["Bash(curl:*)"]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/codekeeper-primer.sh",
            "timeout": 25,
            "statusMessage": "טוען הוראות סוכן מ-CodeKeeper..."
          }
        ]
      }
    ]
  }
}
