{
  "mcpServers": {
    "render": {
      "type": "http",
      "url": "https://mcp.render.com/mcp",
      "headers": {
        "Authorization": "Bearer ${RENDER_API_KEY}"
      }
    },
    "contextstream": {
      "type": "http",
      "url": "https://mcp.contextstream.io/mcp?default_context_mode=fast",
      "headers": {
        "X-ContextStream-API-Key": "${CONTEXTSTREAM_API_KEY}"
      }
    }
  }
}
